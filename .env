# Bilibili RAG local environment
# Fill values only when needed. Leave blank values to use app defaults.

# LLM provider: dashscope, deepseek, openai_native, kimi, siliconflow, zhipu
LLM_PROVIDER=dashscope

# API keys
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=

# App
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/bilibili_rag.db
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
