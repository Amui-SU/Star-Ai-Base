# Bilibili RAG local environment template
# Copy this file to .env.local for personal secrets:
#   Copy-Item .env.example .env.local
#
# Keep real API keys, OAuth secrets, SMTP passwords, and deployment-only
# values out of git.

# LLM provider: dashscope, deepseek, openai, kimi, siliconflow, zhipu
LLM_PROVIDER=dashscope

# DashScope / OpenAI-compatible defaults
DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo
EMBEDDING_MODEL=text-embedding-3-small
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_MODEL=paraformer-v2
ASR_MODEL_LOCAL=paraformer-realtime-v2
ASR_TIMEOUT=600
ASR_INPUT_FORMAT=pcm

# Optional LLM providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_THINKING_CONFIG=

OPENAI_NATIVE_API_KEY=
OPENAI_NATIVE_BASE_URL=https://api.openai.com/v1
OPENAI_NATIVE_MODEL=gpt-4o-mini
OPENAI_NATIVE_THINKING_CONFIG=

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_THINKING_CONFIG=

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_THINKING_CONFIG=

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash
ZHIPU_THINKING_CONFIG=

DASHSCOPE_THINKING_CONFIG=

# Web search
WEB_SEARCH_PROVIDER=html
TAVILY_API_KEY=
WEB_SEARCH_FALLBACK_HTML=true
TAVILY_SEARCH_DEPTH=basic

# User API account policy
API_ACCOUNT_MODE=user_required
PLATFORM_API_ENABLED=false
BILLING_ENABLED=false

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/bilibili_rag.db
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
WECHAT_REDIRECT_URI=

QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
QQ_REDIRECT_URI=

# Email verification
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Admins
# Leave empty to make the first registered local user an admin.
# Use comma-separated emails when set, for example:
# ADMIN_EMAILS=admin@example.com,owner@example.com
ADMIN_EMAILS=

# Security
# Required when DEBUG=false and encrypted source credentials are used.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Optional HTTP proxy for providers that need it.
HTTP_PROXY=
