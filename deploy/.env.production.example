# Copy to deploy/.env.production on the ECS host and chmod 600.
# Never commit the populated production file.

DEBUG=false
SESSION_COOKIE_SECURE=true

DATABASE_URL=sqlite+aiosqlite:///./data/bilibili_rag.db
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Comma-separated production administrator email addresses.
ADMIN_EMAILS=REPLACE_WITH_ADMIN_EMAIL

# Generate a Fernet-compatible key using only the Python 3 standard library:
# python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Configure all four SMTP values, or remove/leave all four empty when Google
# login is fully configured.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=REPLACE_WITH_SMTP_FROM
SMTP_USE_TLS=true

# Configure both Google values, or remove/leave both empty when SMTP is usable.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://zhiku-cloud.cn/system-auth/google/callback

# Optional LLM provider, search, proxy, and platform API keys are documented
# in the root .env.example. Add only the providers enabled in production.
