#!/usr/bin/env bash

set -u

active_producer_pid=""

producer_is_active_job() {
    expected_pid=$1
    while IFS= read -r job_pid; do
        if [ "$job_pid" = "$expected_pid" ]; then
            return 0
        fi
    done < <(jobs -p)
    return 1
}

poll_producer_exit() {
    polled_pid=$1
    poll_count=0
    while [ "$poll_count" -lt 20 ]; do
        if ! producer_is_active_job "$polled_pid"; then
            return 0
        fi
        sleep 0.05
        poll_count=$((poll_count + 1))
    done
    return 1
}

cleanup_active_producer() {
    trap '' HUP INT TERM
    producer_pid="$active_producer_pid"
    if [ -z "$producer_pid" ]; then
        return 0
    fi

    if producer_is_active_job "$producer_pid"; then
        kill -TERM "$producer_pid" 2>/dev/null || true
    fi
    if ! poll_producer_exit "$producer_pid"; then
        if producer_is_active_job "$producer_pid"; then
            kill -KILL "$producer_pid" 2>/dev/null || true
        fi
        poll_producer_exit "$producer_pid" || true
    fi

    if ! producer_is_active_job "$producer_pid"; then
        active_producer_pid=""
        wait "$producer_pid" 2>/dev/null || true
    fi
    return 0
}

trap cleanup_active_producer EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

repo_root=$(git rev-parse --show-toplevel) || exit $?
cd -- "$repo_root" || exit $?

coproc { exec git config --local --null --get-all workflow.useRepositoryHook 2>/dev/null; }
exec {config_fd}<&${COPROC[0]}
config_pid=$COPROC_PID
active_producer_pid=$config_pid
local_opt_ins=()
config_truncated=0
while :; do
    config_value=""
    if IFS= read -r -d '' config_value <&$config_fd; then
        local_opt_ins+=("$config_value")
        continue
    fi
    if [ -n "$config_value" ]; then
        config_truncated=1
    fi
    break
done
exec {config_fd}<&-
wait "$config_pid"
config_status=$?
active_producer_pid=""

if [ "$config_status" -ne 0 ] && ! {
    [ "$config_status" -eq 1 ] && [ "${#local_opt_ins[@]}" -eq 0 ] && [ "$config_truncated" -eq 0 ]
}; then
    printf 'pre-commit: could not read repository-local workflow.useRepositoryHook\n' >&2
    exit "$config_status"
fi
if [ "$config_truncated" -eq 1 ]; then
    printf 'pre-commit: truncated NUL stream from local config\n' >&2
    exit 1
fi

if [ "${#local_opt_ins[@]}" -eq 1 ] && [ "${local_opt_ins[0]}" = "true" ]; then
    verifier="$repo_root/scripts/verify-staged.ps1"
    if [ ! -f "$verifier" ]; then
        printf 'pre-commit: repository verifier script is missing: %s\n' "$verifier" >&2
        exit 1
    fi

    if command -v pwsh >/dev/null 2>&1; then
        powershell_command=pwsh
    elif command -v powershell.exe >/dev/null 2>&1; then
        powershell_command=powershell.exe
    elif command -v powershell >/dev/null 2>&1; then
        powershell_command=powershell
    else
        printf 'pre-commit: PowerShell is required by the repository verifier\n' >&2
        exit 1
    fi

    "$powershell_command" -NoProfile -ExecutionPolicy Bypass -File "$verifier"
    exit $?
fi

coproc { exec git diff --cached --name-only -z --diff-filter=ACMR; }
exec {staged_fd}<&${COPROC[0]}
staged_pid=$COPROC_PID
active_producer_pid=$staged_pid
python_files=()
web_files=()
staged_truncated=0
while :; do
    path=""
    if ! IFS= read -r -d '' path <&$staged_fd; then
        if [ -n "$path" ]; then
            staged_truncated=1
        fi
        break
    fi
    lower_path=${path,,}
    case "$lower_path" in
        *.py) python_files+=("$path") ;;
        *.js|*.jsx|*.ts|*.tsx|*.json|*.css|*.scss|*.less|*.html|*.md|*.mdx|*.yaml|*.yml)
            web_files+=("$path")
            ;;
    esac
done
exec {staged_fd}<&-
wait "$staged_pid"
git_status=$?
active_producer_pid=""
if [ "$git_status" -ne 0 ]; then
    exit "$git_status"
fi
if [ "$staged_truncated" -eq 1 ]; then
    printf 'pre-commit: truncated NUL stream from staged path list\n' >&2
    exit 1
fi

if [ "${#python_files[@]}" -gt 0 ]; then
    if command -v ruff >/dev/null 2>&1; then
        ruff format --check -- "${python_files[@]}"
        tool_status=$?
    elif command -v black >/dev/null 2>&1; then
        black --check -- "${python_files[@]}"
        tool_status=$?
    elif command -v python3 >/dev/null 2>&1; then
        python3 -m py_compile -- "${python_files[@]}"
        tool_status=$?
    elif command -v python >/dev/null 2>&1; then
        python -m py_compile -- "${python_files[@]}"
        tool_status=$?
    else
        printf 'pre-commit: warning: no local Python checker is available; Python files were not checked\n' >&2
        tool_status=0
    fi
    if [ "$tool_status" -ne 0 ]; then
        exit "$tool_status"
    fi
fi

if [ "${#web_files[@]}" -gt 0 ]; then
    if command -v prettier >/dev/null 2>&1; then
        prettier --check -- "${web_files[@]}"
        tool_status=$?
        if [ "$tool_status" -ne 0 ]; then
            exit "$tool_status"
        fi
    else
        printf 'pre-commit: warning: no local Prettier executable is available; web files were not checked\n' >&2
    fi
fi

exit 0
